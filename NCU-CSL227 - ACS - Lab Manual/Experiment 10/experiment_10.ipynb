   "source": [
    "## Experiment 10\n",
    "### Write python code to find critical value in normal distribution.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "The critical value is: 1.959963984540054\n"
     ]
    }
   ],
   "source": [
    "\n",
    "from scipy.stats import norm\n",
    "\n",
    "\n",
    "alpha = 0.05\n",
    "\n",
    "\n",
    "mu = 0\n",
    "sigma = 1\n",
    "\n",
    "\n",
    "critical_value = norm.ppf(1 - alpha/2, loc=mu, scale=sigma)\n",
    "\n",
    "\n",
    "print(\"The critical value is:\", critical_value)\n"
   ]
  }
 ],
